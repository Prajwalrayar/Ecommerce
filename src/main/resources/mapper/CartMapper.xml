<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crimsonlogic.ecommerce.mapper.CartMapper">

    <!-- ===================================================== -->
    <!-- Result Map -->
    <!-- ===================================================== -->

    <resultMap id="CartResultMap"
               type="com.crimsonlogic.ecommerce.model.Cart">

        <id property="cartId"
            column="cart_id"/>

        <result property="quantity"
                column="quantity"/>

        <association property="customer"
                     javaType="com.crimsonlogic.ecommerce.model.Customer">

            <id property="userId"
                column="user_id"/>

            <result property="userName"
                    column="user_name"/>

            <result property="userEmail"
                    column="user_email"/>

            <result property="userPhNo"
                    column="user_phone"/>

            <result property="walletBalance"
                    column="wallet_balance"/>

        </association>

        <association property="product"
                     javaType="com.crimsonlogic.ecommerce.model.Product">

            <id property="productId"
                column="product_id"/>

            <result property="productName"
                    column="product_name"/>

            <result property="productDescription"
                    column="product_description"/>

            <result property="productPrice"
                    column="product_price"/>

            <result property="productStatus"
                    column="product_status"/>

            <association property="category"
                         javaType="com.crimsonlogic.ecommerce.model.Category">

                <id property="categoryId"
                    column="category_id"/>

                <result property="categoryName"
                        column="category_name"/>

            </association>

            <association property="seller"
                         javaType="com.crimsonlogic.ecommerce.model.Seller">

                <id property="userId"
                    column="seller_id"/>

                <result property="userName"
                        column="seller_name"/>

                <result property="shopName"
                        column="shop_name"/>

            </association>

        </association>

    </resultMap>

    <!-- ===================================================== -->
    <!-- Insert -->
    <!-- ===================================================== -->

    <insert id="insertCartItem">

        INSERT INTO cart(

        cart_id,

        user_id,

        product_id,

        quantity

        )

        VALUES(

        #{cartId},

        #{customer.userId},

        #{product.productId},

        #{quantity}

        )

    </insert>

    <!-- ===================================================== -->
    <!-- Update -->
    <!-- ===================================================== -->

    <update id="updateCartItem">

        UPDATE cart

        SET

        quantity = #{quantity}

        WHERE cart_id = #{cartId}

    </update>

    <!-- ===================================================== -->
    <!-- Delete -->
    <!-- ===================================================== -->

    <delete id="deleteCartItem">

        DELETE

        FROM cart

        WHERE cart_id = #{cartId}

    </delete>

    <!-- ===================================================== -->
    <!-- Clear Cart -->
    <!-- ===================================================== -->

    <delete id="clearCart">

        DELETE

        FROM cart

        WHERE user_id = #{customerId}

    </delete>

    <!-- ===================================================== -->
    <!-- Find Cart By ID -->
    <!-- ===================================================== -->

    <select id="findCartItemById"
            resultMap="CartResultMap">

        SELECT

        ct.*,

        cu.user_name,
        cu.user_email,
        cu.user_phone,
        cu.wallet_balance,

        p.*,

        c.category_name,

        s.shop_name,
        s.user_name AS seller_name,
        s.user_id AS seller_id

        FROM cart ct

        INNER JOIN customers cu
        ON ct.user_id = cu.user_id

        INNER JOIN products p
        ON ct.product_id = p.product_id

        INNER JOIN categories c
        ON p.category_id = c.category_id

        INNER JOIN sellers s
        ON p.user_id = s.user_id

        WHERE ct.cart_id = #{cartId}

    </select>

    <!-- ===================================================== -->
    <!-- Find Cart Item -->
    <!-- ===================================================== -->

    <select id="findCartItem"
            resultMap="CartResultMap">

        SELECT

        ct.*,

        cu.user_name,
        cu.user_email,
        cu.user_phone,
        cu.wallet_balance,

        p.*,

        c.category_name,

        s.shop_name,
        s.user_name AS seller_name,
        s.user_id AS seller_id

        FROM cart ct

        INNER JOIN customers cu
        ON ct.user_id = cu.user_id

        INNER JOIN products p
        ON ct.product_id = p.product_id

        INNER JOIN categories c
        ON p.category_id = c.category_id

        INNER JOIN sellers s
        ON p.user_id = s.user_id

        WHERE ct.user_id = #{customerId}

        AND ct.product_id = #{productId}

    </select>

    <!-- ===================================================== -->
    <!-- Find Cart By Customer -->
    <!-- ===================================================== -->

    <select id="findCartByCustomer"
            resultMap="CartResultMap">

        SELECT

        ct.*,

        cu.user_name,
        cu.user_email,
        cu.user_phone,
        cu.wallet_balance,

        p.*,

        c.category_name,

        s.shop_name,
        s.user_name AS seller_name,
        s.user_id AS seller_id

        FROM cart ct

        INNER JOIN customers cu
        ON ct.user_id = cu.user_id

        INNER JOIN products p
        ON ct.product_id = p.product_id

        INNER JOIN categories c
        ON p.category_id = c.category_id

        INNER JOIN sellers s
        ON p.user_id = s.user_id

        WHERE ct.user_id = #{customerId}

    </select>

    <!-- ===================================================== -->
    <!-- Find All Cart Items -->
    <!-- ===================================================== -->

    <select id="findAllCartItems"
            resultMap="CartResultMap">

        SELECT

        ct.*,

        cu.user_name,
        cu.user_email,
        cu.user_phone,
        cu.wallet_balance,

        p.*,

        c.category_name,

        s.shop_name,
        s.user_name AS seller_name,
        s.user_id AS seller_id

        FROM cart ct

        INNER JOIN customers cu
        ON ct.user_id = cu.user_id

        INNER JOIN products p
        ON ct.product_id = p.product_id

        INNER JOIN categories c
        ON p.category_id = c.category_id

        INNER JOIN sellers s
        ON p.user_id = s.user_id

    </select>

</mapper>