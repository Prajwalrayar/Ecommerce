<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crimsonlogic.ecommerce.mapper.CustomerMapper">

    <!-- ===================================================== -->
    <!-- Result Map -->
    <!-- ===================================================== -->

    <resultMap id="CustomerResultMap"
               type="com.crimsonlogic.ecommerce.model.Customer">

        <id property="userId"
            column="user_id"/>

        <result property="userName"
                column="user_name"/>

        <result property="userEmail"
                column="user_email"/>

        <result property="userPhNo"
                column="user_phone"/>

        <result property="userPassword"
                column="user_password"/>

        <result property="walletBalance"
                column="wallet_balance"/>

        <association property="address"
                     javaType="com.crimsonlogic.ecommerce.model.Address">

            <id property="addressId"
                column="address_id"/>

            <result property="houseNumber"
                    column="house_number"/>

            <result property="street"
                    column="street"/>

            <result property="city"
                    column="city"/>

            <result property="state"
                    column="state"/>

            <result property="country"
                    column="country"/>

            <result property="zipCode"
                    column="zip_code"/>

        </association>

    </resultMap>

    <!-- ===================================================== -->
    <!-- Insert -->
    <!-- ===================================================== -->

    <insert id="insertCustomer">

        INSERT INTO customers(

        user_id,

        user_name,

        user_email,

        user_phone,

        user_password,

        wallet_balance,

        address_id

        )

        VALUES(

        #{userId},

        #{userName},

        #{userEmail},

        #{userPhNo},

        #{userPassword},

        #{walletBalance},

        #{address.addressId}

        )

    </insert>

    <!-- ===================================================== -->
    <!-- Update -->
    <!-- ===================================================== -->

    <update id="updateCustomer">

        UPDATE customers

        SET

        user_name = #{userName},

        user_email = #{userEmail},

        user_phone = #{userPhNo},

        user_password = #{userPassword},

        wallet_balance = #{walletBalance},

        address_id = #{address.addressId}

        WHERE user_id = #{userId}

    </update>

    <!-- ===================================================== -->
    <!-- Update Wallet -->
    <!-- ===================================================== -->

    <update id="updateWalletBalance">

        UPDATE customers

        SET

        wallet_balance = #{walletBalance}

        WHERE user_id = #{userId}

    </update>

    <!-- ===================================================== -->
    <!-- Delete -->
    <!-- ===================================================== -->

    <delete id="deleteCustomer">

        DELETE FROM customers

        WHERE user_id = #{userId}

    </delete>

    <!-- ===================================================== -->
    <!-- Find By ID -->
    <!-- ===================================================== -->

    <select id="findCustomerById"
            resultMap="CustomerResultMap">

        SELECT

        c.*,

        a.*

        FROM customers c

        LEFT JOIN address a

        ON c.address_id = a.address_id

        WHERE c.user_id = #{userId}

    </select>

    <!-- ===================================================== -->
    <!-- Find By Email -->
    <!-- ===================================================== -->

    <select id="findCustomerByEmail"
            resultMap="CustomerResultMap">

        SELECT

        c.*,

        a.*

        FROM customers c

        LEFT JOIN address a

        ON c.address_id = a.address_id

        WHERE c.user_email = #{email}

    </select>

    <!-- ===================================================== -->
    <!-- Find By Phone -->
    <!-- ===================================================== -->

    <select id="findCustomerByPhone"
            resultMap="CustomerResultMap">

        SELECT

        c.*,

        a.*

        FROM customers c

        LEFT JOIN address a

        ON c.address_id = a.address_id

        WHERE c.user_phone = #{phone}

    </select>

    <!-- ===================================================== -->
    <!-- Find All -->
    <!-- ===================================================== -->

    <select id="findAllCustomers"
            resultMap="CustomerResultMap">

        SELECT

        c.*,

        a.*

        FROM customers c

        LEFT JOIN address a

        ON c.address_id = a.address_id

        ORDER BY c.user_name

    </select>

</mapper>